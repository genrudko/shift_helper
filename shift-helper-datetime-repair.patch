+    serial = "If n >= 20000# And n < 80000# Then"
+    assert compact in quick and serial in quick
+    assert quick.index(compact) < quick.index(serial)
+    assert "If CDbl(value) = Int(CDbl(value)) Then Exit Function" in quick
