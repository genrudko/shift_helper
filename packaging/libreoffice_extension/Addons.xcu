        <node oor:name="Time" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?time</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Часы</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="AutoFit" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?autofit</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Высота строк</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="Clean" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?clean</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Очистить пробелы</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="MergeCopy" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?mergecopy</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Объединить и копировать</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="SortTime" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?sorttime</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Сортировать по времени</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="Maintenance" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?maintenance</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Текст ТО ВЭУ</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="Inspections" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?inspections</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Осмотры смены</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>
        <node oor:name="Rotor" oor:op="replace">
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="URL" oor:type="xs:string"><value>service:ru.kves.shifthelper.calc.controls?rotor</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="ru-RU">Ограничения оборотов</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
