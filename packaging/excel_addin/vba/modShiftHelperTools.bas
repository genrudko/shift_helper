Attribute VB_Name = "modShiftHelperTools"
Option Explicit

Public Sub SH_ShowTimePicker()
    On Error GoTo Failed
    Dim wb As Workbook, target As Range, answer As Variant, token As String, parts As Variant
    Dim hourValue As Long, minuteValue As Long, cell As Range, defaultText As String
    Set wb = SH_JournalBook()
    Set target = SH_SelectionRange(wb)
    defaultText = Format$(Now, "hh:mm")
    If target.Cells.CountLarge > 0 Then
        If IsNumeric(target.Cells(1, 1).Value2) And CDbl(target.Cells(1, 1).Value2) >= 0 And CDbl(target.Cells(1, 1).Value2) < 1 Then
            defaultText = Format$(target.Cells(1, 1).Value2, "hh:mm")
        End If
    End If
    answer = Application.InputBox( _
        SH_U("04120432043504340438044204350020043204400435043C044F0020043200200444043E0440043C043004420435002004270427003A041C041C002E0020041F044304410442043E043500200437043D043004470435043D043804350020043E0442043C0435043D044F043504420020043E043F04350440043004460438044E002E"), _
        SH_U("0412044B0431043E04400020043204400435043C0435043D0438002004270427003A041C041C"), defaultText, Type:=2)
    If VarType(answer) = vbBoolean Then If answer = False Then Exit Sub
    token = Trim$(CStr(answer))
    If Len(token) = 0 Then Exit Sub
    parts = Split(token, ":")
    If UBound(parts) <> 1 Then Err.Raise vbObjectError + 610, , SH_U("041204400435043C044F00200434043E043B0436043D043E00200431044B0442044C002004320020043404380430043F04300437043E043D0435002000300030003A00300030201300320033003A00350039002E")
    If Not IsNumeric(parts(0)) Or Not IsNumeric(parts(1)) Then Err.Raise vbObjectError + 611, , SH_U("041204400435043C044F00200434043E043B0436043D043E00200431044B0442044C002004320020043404380430043F04300437043E043D0435002000300030003A00300030201300320033003A00350039002E")
    hourValue = CLng(parts(0)): minuteValue = CLng(parts(1))
    If hourValue < 0 Or hourValue > 23 Or minuteValue < 0 Or minuteValue > 59 Then Err.Raise vbObjectError + 612, , SH_U("041204400435043C044F00200434043E043B0436043D043E00200431044B0442044C002004320020043404380430043F04300437043E043D0435002000300030003A00300030201300320033003A00350039002E")
    For Each cell In target.Cells
        cell.Value2 = CDbl(TimeSerial(hourValue, minuteValue, 0))
        cell.NumberFormat = "hh:mm"
        cell.HorizontalAlignment = xlCenter
    Next cell
    Exit Sub
Failed:
    MsgBox Err.Description, vbExclamation, "Shift-Helper"
End Sub

Public Sub SH_InsertMaintenanceText()
    On Error GoTo Failed
    Dim wb As Workbook, target As Range, raw As Variant, numbers As Collection
    Dim index As Long, number As Long, mode As VbMsgBoxResult, yearsAnswer As Variant, years As Long
    Dim bolt As VbMsgBoxResult, textValue As String
    Set wb = SH_JournalBook()
    Set target = SH_SelectionRange(wb)
    raw = Application.InputBox( _
        SH_U("04120432043504340438044204350020043D043E043C04350440043000200412042D0423002004470435044004350437002004370430043F044F04420443044E00200028043D0430043F04400438043C04350440003A00200031002C0032002C00330029003A"), _
        SH_U("041D043E043C04350440043000200412042D0423"), Type:=2)
    If VarType(raw) = vbBoolean Then If raw = False Then Exit Sub
    Set numbers = SH_ParseWtgNumbers(CStr(raw))
    If numbers.Count <> target.Cells.CountLarge Then Err.Raise vbObjectError + 620, , SH_U("041A043E043B043804470435044104420432043E00200432044B04340435043B0435043D043D044B04450020044F044704350435043A00200434043E043B0436043D043E00200441043E0432043F0430043404300442044C002004410020043A043E043B043804470435044104420432043E043C0020043D043E043C04350440043E043200200412042D0423002E")

    For index = 1 To numbers.Count
        number = CLng(numbers(index))
        mode = MsgBox( _
            SH_U("0414043B044F00200412042D0423002D") & CStr(number) & SH_U("003A000A041404300020201400200422041E002D00360020043C04350441044F044604350432000A041D043504420020201400200422041E0020043200200433043E043404300445"), _
            vbYesNoCancel Or vbQuestion, SH_U("0412044B0431043E044000200422041E"))
        If mode = vbCancel Then Exit Sub
        If mode = vbYes Then
            textValue = SH_MaintenanceText(number, True, 0, False)
        Else
            yearsAnswer = Application.InputBox( _
                SH_U("04120432043504340438044204350020044704380441043B043E0020043B0435044200200434043B044F00200412042D0423002D") & CStr(number) & SH_U("00200028043D0430043F04400438043C04350440003A00200031002C00200032002C002000330029003A"), _
                SH_U("0422041E0020043200200433043E043404300445"), 1, Type:=1)
            If VarType(yearsAnswer) = vbBoolean Then If yearsAnswer = False Then Exit Sub
            If Not IsNumeric(yearsAnswer) Then Err.Raise vbObjectError + 621, , SH_U("041A043E043B043804470435044104420432043E0020043B0435044200200434043E043B0436043D043E00200431044B0442044C002004460435043B044B043C0020043F043E043B043E0436043804420435043B044C043D044B043C0020044704380441043B043E043C002E")
            years = CLng(yearsAnswer)
            If years <= 0 Then Err.Raise vbObjectError + 622, , SH_U("041A043E043B043804470435044104420432043E0020043B0435044200200434043E043B0436043D043E00200431044B0442044C002004460435043B044B043C0020043F043E043B043E0436043804420435043B044C043D044B043C0020044704380441043B043E043C002E")
            bolt = MsgBox( _
                SH_U("0414043B044F00200412042D0423002D") & CStr(number) & SH_U("003A0020043504410442044C0020043B04380020043F0440043E043204350440043A04300020043C043E043C0435043D0442043E04320020043704300442044F0436043A043800200431043E043B0442043E0432044B044500200441043E043504340438043D0435043D04380439003F"), _
                vbYesNo Or vbQuestion, SH_U("041F0440043E0442044F0436043A043000200431043E043B0442043E0432"))
            textValue = SH_MaintenanceText(number, False, years, bolt = vbYes)
        End If
        target.Cells(index, 1).Value = textValue
        target.Cells(index, 1).WrapText = True
    Next index
    target.EntireRow.AutoFit
    MsgBox SH_U("04220435043A04410442044B00200422041E002004320441044204300432043B0435043D044B002C00200432044B0441043E044204300020044104420440043E043A0020043F043E0434043E0433043D0430043D0430002E"), vbInformation, "Shift-Helper"
    Exit Sub
Failed:
    MsgBox SH_U("041D04350020044304340430043B043E0441044C00200432044104420430043204380442044C002004420435043A04410442044B00200422041E003A0020") & Err.Description, vbExclamation, "Shift-Helper"
End Sub

Private Function SH_ParseWtgNumbers(ByVal raw As String) As Collection
    Dim result As New Collection, normalized As String, parts As Variant, token As Variant
    Dim value As Long, seen(1 To 84) As Boolean
    normalized = Replace(Replace(Replace(raw, ";", ","), vbTab, ","), " ", ",")
    Do While InStr(normalized, ",,") > 0
        normalized = Replace(normalized, ",,", ",")
    Loop
    parts = Split(normalized, ",")
    For Each token In parts
        If Len(Trim$(CStr(token))) > 0 Then
            If Not IsNumeric(Trim$(CStr(token))) Then Err.Raise vbObjectError + 623, , "WTG number: " & CStr(token)
            value = CLng(Trim$(CStr(token)))
            If value < 1 Or value > 84 Then Err.Raise vbObjectError + 624, , "WTG 1..84: " & CStr(value)
            If Not seen(value) Then result.Add value: seen(value) = True
        End If
    Next token
    If result.Count = 0 Then Err.Raise vbObjectError + 625, , SH_U("041D043500200443043A043004370430043D044B0020043D043E043C04350440043000200412042D0423002E")
    Set SH_ParseWtgNumbers = result
End Function

Private Function SH_MaintenanceText(ByVal number As Long, ByVal halfYear As Boolean, ByVal years As Long, ByVal bolt As Boolean) As String
    Dim n As String, yearText As String
    n = CStr(number)
    If halfYear Then
        SH_MaintenanceText = SH_U("0412042D0423002D") & n & SH_U("") & n & SH_U("002C0020043A043E043D04320435044004420435044004350020041A002D0032002D") & n & SH_U("002C0020041204200423002D0030002C00360039002C0020044204350445043D0438044704350441043A043804390020043E0441043C043E04420440002004410438044104420435043C044B0020043E0445043B0430043604340435043D0438044F0020043A043E043D04320435044004420435044004300020041A002D0031002D") & n & SH_U("002004380020043A043E043D04320435044004420435044004300020041A002D0032002D") & n & SH_U("00200431043504370020043F0440043E043D0438043A043D043E04320435043D0438044F002004370430002004370430044904380442043D044B04350020043E043304400430043604340435043D0438044F002E")
        Exit Function
    End If
    yearText = CStr(years) & " " & SH_YearWord(years)
    If bolt Then
        SH_MaintenanceText = SH_U("0412042D0423002D") & n & SH_U("003A0020043104300437043E04320430044F0020043F043B043004420444043E0440043C0430002C0020043A043E043D0432043504400442043504400020041A002D0031002D") & n & SH_U("002C0020043A043E043D0432043504400442043504400020041A002D0032002D") & n & SH_U("002C002004220421041D00200412042D0423002D") & n & SH_U("002C0020041204200423002D0030002C003600390020002D0020042204350445043D0438044704350441043A043E04350020043E04310441043B04430436043804320430043D0438043500200412042D0423002004320020043E0431044A0435043C043500200422041E0020") & yearText & SH_U("") & n & SH_U("002C0020043A043E043D04320435044004420435044004350020041A002D0032002D") & n & SH_U("002C002004220421041D00200412042D0423002D") & n & SH_U("002C0020041204200423002D0030002C00360039002E")
    Else
        SH_MaintenanceText = SH_U("0412042D0423002D") & n & SH_U("") & yearText & SH_U("002004370430002004380441043A043B044E04470435043D04380435043C0020044004300431043E04420020043D043000200442043E043A043E043204350434044304490438044500200447043004410442044F0445002004320020043A043E043D04320435044004420435044004350020041A002D0031002D") & n & SH_U("002C0020043A043E043D04320435044004420435044004350020041A002D0032002D") & n & SH_U("002C0020041204200423002D0030002C00360039002C0020044204350445043D0438044704350441043A043804390020043E0441043C043E04420440002004410438044104420435043C044B0020043E0445043B0430043604340435043D0438044F0020043A043E043D04320435044004420435044004300020041A002D0031002D") & n & SH_U("002004380020043A043E043D04320435044004420435044004300020041A002D0032002D") & n & SH_U("00200431043504370020043F0440043E043D0438043A043D043E04320435043D0438044F002004370430002004370430044904380442043D044B04350020043E043304400430043604340435043D0438044F002E")
    End If
End Function

Private Function SH_YearWord(ByVal years As Long) As String
    Dim lastDigit As Long, lastTwo As Long
    years = Abs(years): lastDigit = years Mod 10: lastTwo = years Mod 100
    If lastDigit = 1 And lastTwo <> 11 Then
        SH_YearWord = SH_U("0433043E0434")
    ElseIf lastDigit >= 2 And lastDigit <= 4 And Not (lastTwo >= 12 And lastTwo <= 14) Then
        SH_YearWord = SH_U("0433043E04340430")
    Else
        SH_YearWord = SH_U("043B04350442")
    End If
End Function

Public Sub SH_CreateOutlookDraft()
    On Error GoTo Failed
    Dim wb As Workbook, ws As Worksheet, outlook As Object, mail As Object
    Dim sentOnBehalf As String, recipient As String, subject As String, body As String, attachment As String
    Set wb = SH_JournalBook()
    Set ws = wb.ActiveSheet
    sentOnBehalf = CStr(ws.Range("B4").Value2)
    recipient = CStr(ws.Range("B5").Value2)
    subject = CStr(ws.Range("B7").Value2)
    body = CStr(ws.Range("B8").Value2) & CStr(ws.Range("B9").Value2)
    attachment = Trim$(CStr(ws.Range("B10").Value2))
    If Len(Trim$(recipient)) = 0 Then Err.Raise vbObjectError + 630, , SH_U("04120020004200350020043D043500200443043A043004370430043D0020043F043E043B04430447043004420435043B044C002E")
    On Error Resume Next
    Set outlook = GetObject(, "Outlook.Application")
    If outlook Is Nothing Then Set outlook = CreateObject("Outlook.Application")
    On Error GoTo Failed
    If outlook Is Nothing Then Err.Raise vbObjectError + 631, , "Outlook is unavailable."
    Set mail = outlook.CreateItem(0)
    If Len(Trim$(sentOnBehalf)) > 0 Then mail.SentOnBehalfOfName = sentOnBehalf
    mail.To = recipient
    mail.Subject = subject
    mail.HTMLBody = body
    If Len(attachment) > 0 Then
        On Error Resume Next
        If Len(Dir$(attachment)) > 0 Then mail.Attachments.Add attachment
        On Error GoTo Failed
    End If
    mail.Display
    MsgBox SH_U("042704350440043D043E04320438043A0020043F04380441044C043C04300020043E0442043A0440044B0442002004320020004F00750074006C006F006F006B002E0020041004320442043E043C043004420438044704350441043A0430044F0020043E0442043F044004300432043A04300020043D043500200432044B043F043E043B043D044F043B04300441044C002E"), vbInformation, "Shift-Helper"
    Exit Sub
Failed:
    MsgBox SH_U("041D04350020044304340430043B043E0441044C00200441043E0437043404300442044C0020043F04380441044C043C043E003A0020") & Err.Description, vbExclamation, "Shift-Helper"
End Sub
